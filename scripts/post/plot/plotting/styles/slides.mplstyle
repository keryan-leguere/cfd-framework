# ============================================================
#  SLIDES profile — presentations (large text, bold lines)
#  Old-school pro: framed axes, framed legend, clean look
# ============================================================

# --- Figure ------------------------------------------------
figure.figsize:        12, 7
figure.dpi:            600
figure.facecolor:      white
figure.constrained_layout.use: True

# --- Patches (drives legend frame thickness) ---------------
patch.linewidth:       1.8

# --- Axes (old school pro: all 4 spines, darker frame) -----
axes.facecolor:        white
axes.edgecolor:        0.10
axes.linewidth:        2.0
axes.grid:             True
axes.grid.axis:        both
axes.axisbelow:        True
axes.titlesize:        28
axes.titleweight:      bold
axes.titlepad:         14
axes.labelsize:        26
axes.labelweight:      normal
axes.labelpad:         8
axes.spines.top:       True
axes.spines.right:     True
axes.spines.bottom:    True
axes.spines.left:      True
axes.formatter.use_mathtext: True

# --- Grid --------------------------------------------------
grid.color:            0.9
grid.linewidth:        1.2
grid.alpha:            0.9
grid.linestyle:        -

# --- Ticks -------------------------------------------------
xtick.direction:       in
ytick.direction:       in
xtick.major.width:     1.5
ytick.major.width:     1.5
xtick.major.size:      8
ytick.major.size:      8
xtick.minor.visible:   True
ytick.minor.visible:   True
xtick.minor.width:      1.5
ytick.minor.width:      1.5
xtick.minor.size:      4
ytick.minor.size:      4
xtick.labelsize:       19
ytick.labelsize:       19
xtick.color:           0.10
ytick.color:           0.10

# --- Lines & markers ---------------------------------------
lines.linewidth:       2.8
lines.markersize:      9
lines.markeredgewidth: 1.8

# Color cycle (professional, distinguishable)
axes.prop_cycle: cycler('color', ['1f77b4', 'e03a3e', '2ca02c', 'ff7f0e', '9467bd', '8c564b', '17becf', 'bcbd22'])

# --- Legend (framed, old school) ---------------------------
legend.frameon:        True
legend.fancybox:       True
legend.edgecolor:      0.10
legend.framealpha:     1.0
legend.facecolor:      white
legend.fontsize:       24
legend.borderpad:      0.3
legend.labelspacing:   0.3
legend.handlelength:   2.0
legend.handleheight:   0.8

# --- Font --------------------------------------------------
# Body text: TeX Gyre Termes (≈ Times New Roman); titles use TITLE_FONT
font.family:           serif
font.serif:            TeX Gyre Termes, Times New Roman, Nimbus Roman, DejaVu Serif, serif
font.sans-serif:       TeX Gyre Heros, Helvetica, Nimbus Sans, DejaVu Sans, sans-serif
font.size:             16
mathtext.fontset:      stix

# --- Savefig -----------------------------------------------
savefig.dpi:           600
savefig.bbox:          tight
savefig.pad_inches:    0.2
savefig.facecolor:     white
savefig.transparent:   False
