#!/usr/bin/env bash
# ---------------------------------------------------------------
# cfd-perf  --  CLI wrapper for the cfd_perf scaling estimator
#
# Usage:  cfd-perf <input_file> <output_figure>
#
#   input_file    Plain-text file describing mesh, pilot and
#                 optimisation parameters (see docs or
#                 build_scaling_input.sh to generate one).
#   output_figure Path for the resulting scaling figure.
#                 Format is inferred from the extension
#                 (.png, .svg, .pdf …).
# ---------------------------------------------------------------
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "Usage: cfd-perf <input_file> <output_figure>" >&2
    exit 1
fi

exec python -m cfd_perf.cli.main "$@"
