#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
#  cfd-creer — Create or resume a CFD case with a tmuxifier session
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Usage: cfd-creer NAME [--template TEMPLATE] [--layout LAYOUT]
#
#  Auteur : KL
#  Licence : MIT
# ═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
FRAMEWORK_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
source "$FRAMEWORK_DIR/lib/format.sh"

# ── Defaults ─────────────────────────────────────────────────────────────────
CASE_NAME=""
TEMPLATE_NAME="TEMPLATE_CASE_DEFAULT"
LAYOUT_NAME="cfd-case"

usage() {
  cat <<EOF

${BOLD}USAGE:${RESET}
  $(basename "$0") NAME [OPTIONS]

${BOLD}DESCRIPTION:${RESET}
  Create a new CFD case from a template or open an existing one, then
  launch a tmuxifier session with a pre-configured window layout.

  If NAME does not exist, a directory is created and populated from the
  selected template.  If NAME already exists, the script reuses it as-is.

${BOLD}POSITIONAL:${RESET}
  NAME                       Name of the case (becomes the directory and
                             the tmux session name)

${BOLD}OPTIONS:${RESET}
  --template <template>      Template to copy (default: TEMPLATE_CASE_DEFAULT)
  --layout  <layout>         Tmuxifier session layout (default: cfd-case)
  --layouts <layout>         Alias for --layout
  -h, --help                 Show this help

${BOLD}EXAMPLES:${RESET}
  cfd-creer AIRFOIL_2D
  cfd-creer NACA0012 --template TEMPLATE_AIRFOIL
  cfd-creer EXISTING_CASE --layout custom-layout

EOF
}

# ── Parse arguments ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --template)
      TEMPLATE_NAME="$2"; shift 2 ;;
    --layout|--layouts)
      LAYOUT_NAME="$2"; shift 2 ;;
    -h|--help)
      usage; exit 0 ;;
    -*)
      _error "Unknown option: $1"; usage; exit 1 ;;
    *)
      if [[ -z "$CASE_NAME" ]]; then
        CASE_NAME="$1"; shift
      else
        _error "Unexpected argument: $1"; usage; exit 1
      fi
      ;;
  esac
done

# ── Normalize NAME (strip trailing slash from tab-completion) ─────────────────
CASE_NAME="${CASE_NAME%/}"

# ── Validate NAME ────────────────────────────────────────────────────────────
if [[ -z "$CASE_NAME" ]]; then
  _error "Case name is required."
  usage
  exit 1
fi

if [[ ! "$CASE_NAME" =~ ^[A-Za-z0-9._-]+$ ]]; then
  _error "Invalid case name. Use only letters, numbers, dot, dash, underscore."
  exit 1
fi

title "cfd-creer — $CASE_NAME"

# ── Dependency checks ────────────────────────────────────────────────────────
for cmd in tmux tmuxifier; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    _error "$cmd is not installed."
    exit 1
  fi
done

# ── Session collision check ──────────────────────────────────────────────────
if tmux has-session -t "=$CASE_NAME" 2>/dev/null; then
  _error "A tmux session named '$CASE_NAME' already exists."
  _note  "Attach with:  tmux attach -t '$CASE_NAME'"
  _note  "Or kill it:   tmux kill-session -t '$CASE_NAME'"
  exit 1
fi

# ── Resolve paths ────────────────────────────────────────────────────────────
CASE_PATH="$(pwd -P)/$CASE_NAME"

# ── Create or reuse ─────────────────────────────────────────────────────────
if [[ -d "$CASE_PATH" ]]; then
  CFD_CASE_IS_NEW=0
  _info "Existing case detected: $CASE_PATH"
else
  CFD_CASE_IS_NEW=1
  mkdir -p "$CASE_PATH"

  TEMPLATE_PATH="$FRAMEWORK_DIR/templates/$TEMPLATE_NAME"
  if [[ -d "$TEMPLATE_PATH" ]]; then
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --exclude=".git" "$TEMPLATE_PATH/" "$CASE_PATH/"
    else
      cp -a "$TEMPLATE_PATH/." "$CASE_PATH/"
      rm -rf "$CASE_PATH/.git" 2>/dev/null || true
    fi
    _result "Template $TEMPLATE_NAME applied"
  else
    _warn "Template '$TEMPLATE_NAME' not found in $FRAMEWORK_DIR/templates/"
  fi

  git -C "$CASE_PATH" init -b main >/dev/null 2>&1 || git -C "$CASE_PATH" init >/dev/null
  git -C "$CASE_PATH" add -A >/dev/null 2>&1 || true
  git -C "$CASE_PATH" commit -m "Initial commit — $CASE_NAME ($TEMPLATE_NAME)" >/dev/null 2>&1 || true
  _result "Git repository initialized"

  _result "Case $CASE_NAME created at $CASE_PATH"
fi

# ── Export variables for the tmuxifier layout ────────────────────────────────
export CASE_NAME
export CASE_PATH
export CFD_TEMPLATE_NAME="$TEMPLATE_NAME"
export CFD_CASE_IS_NEW
export CFD_LAYOUT_DIR="$FRAMEWORK_DIR/tmuxifier-layouts"

# ── Load the tmuxifier layout ───────────────────────────────────────────────
LAYOUT_FILE="${CFD_LAYOUT_DIR}/${LAYOUT_NAME}.session.sh"
if [[ ! -f "$LAYOUT_FILE" ]]; then
  _error "Layout file not found: $LAYOUT_FILE"
  _note "Available layouts in: $CFD_LAYOUT_DIR/"
  exit 1
fi

_info "Loading tmuxifier layout: $LAYOUT_NAME"
tmuxifier load-session "$LAYOUT_FILE"
